        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scriosadh go buan go léir na leabhair, na scoláire, na seiceálacha amach, agus gníomhaíochta. Ní féidir an gníomh seo a bhaint ar ais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
